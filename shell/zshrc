ZSH_HIGHLIGHT_STYLES[bracket-level-5]=fg=cyan,bold
ZSH_HIGHLIGHT_STYLES[cursor-matchingbracket]=standout
# Remap foreground colors while retaining bold, underline, and other attributes.
() {
  local style value color
  for style in ${(k)ZSH_HIGHLIGHT_STYLES}; do
    value=${ZSH_HIGHLIGHT_STYLES[$style]}
    if [[ $value == fg=* ]]; then
      color=${${value#fg=}%%,*}
      if (( ${+redflake_palette[$color]} )); then
        ZSH_HIGHLIGHT_STYLES[$style]="fg=${redflake_palette[$color]}${value#fg=$color}"
      fi
    fi
  done
}
source "@syntaxHighlighting@"
